<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Dynotch</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.peterkereki.Dynotch</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>dynotch</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>Dynotch reads and saves your notes in Notes, sends a text through Messages when you reply to a call, and shows and controls what Spotify plays.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Dynotch shows a notice when a Bluetooth device connects or disconnects, with its battery.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Dynotch shows your upcoming events in the notch.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Dynotch shows your upcoming events in the notch.</string>
	<key>NSContactsUsageDescription</key>
	<string>Dynotch looks up the caller's phone number to send them a text.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Dynotch puts a file you just downloaded into the Tray when the notch opens.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Dynotch</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Dynotch records your voice with a screen recording when you turn the microphone on.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Dynotch shows your reminders and checks them off in the notch and the menu bar.</string>
	<key>NSRemindersUsageDescription</key>
	<string>Dynotch shows your reminders and checks them off in the notch and the menu bar.</string>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>New Dynotch Note</string>
			</dict>
			<key>NSMessage</key>
			<string>makeNote</string>
			<key>NSPortName</key>
			<string>Dynotch</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendTypes</key>
			<array>
				<string>NSStringPboardType</string>
				<string>public.utf8-plain-text</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
